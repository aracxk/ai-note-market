{
	"name": "ai-note-market",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:e2e": "playwright test",
		"coverage": "vitest run --coverage",
		"typecheck": "tsc --noEmit",
		"prepare": "husky"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@hookform/resolvers": "^5.9.1",
		"@next/third-parties": "^16.3.5",
		"@tailwindcss/postcss": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.2.6",
		"lucide-react": "^1.45.0",
		"next": "^14.2.5",
		"postcss": "^8.5.28",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-hook-form": "^7.87.0",
		"shadcn": "^4.21.0",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"zod": "^3.23.8"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.12",
		"@playwright/test": "^1.45.3",
		"@types/node": "^20.14.12",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@vitest/coverage-v8": "^2.1.9",
		"husky": "^9.1.7",
		"lint-staged": "^16.4.0",
		"typescript": "^5.5.4",
		"vitest": "^2.0.4"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched"
		]
	}
}
